{
  "manifest_version": 3,
  "name": "AJDM - Ariga Justine Download Manager",
  "short_name": "AJDM",
  "version": "1.0.0",
  "description": "Download links, files and videos with AJDM. Downloads continue in the browser when AJDM is not running.",
  "icons": {"16": "icons/ajdm-16.png", "48": "icons/ajdm-48.png", "128": "icons/ajdm-128.png"},
  "permissions": ["contextMenus", "downloads", "nativeMessaging", "storage"],
  "background": {"scripts": ["background.js"], "type": "module"},
  "content_scripts": [{"matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle"}],
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "browser_specific_settings": {"gecko": {"id": "ajdm@ariga.dev", "strict_min_version": "128.0"}}
}
